# ====================================
# ProyectoT3 — Variables de Entorno
# ====================================
# Copia este archivo como .env y configura los valores.
# NUNCA commitees el archivo .env real.

# Base de Datos
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=condominio_cobranzas

# Entorno: 'development' o 'production'
ENVIRONMENT=development

# Seguridad y Cifrado
# Generar con: openssl rand -base64 32
NOTIFICATION_ENCRYPT_KEY=clave_cifrado_aes_256_minimo_32_caracteres_ejemplo
JWT_SECRET=clave_secreta_jwt_minimo_32_caracteres_ejemplo_segura
