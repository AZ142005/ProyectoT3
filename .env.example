# ====================================
# ProyectoT3 — Variables de Entorno
# ====================================
# Copiar este archivo a .env y completar los valores ANTES de iniciar la aplicación.

# Base de Datos
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=condominio_cobranzas

# Entorno: 'development' o 'production'
ENVIRONMENT=development

# ─────────────────────────────────────────────────────────────
# CLAVES DE SEGURIDAD (OBLIGATORIAS — Generación Única)
# ─────────────────────────────────────────────────────────────

# Clave secreta para firmar tokens JWT (HS256).
# REQUISITO: mínimo 64 bytes (128 caracteres hex).
# ⚠ NUNCA compartir ni subir al control de versiones.
# Generar con (Linux/macOS/WSL/Git Bash):
#   openssl rand -base64 32
# Generar con PowerShell:
#   [Convert]::ToBase64String((1..32 | ForEach-Object { [byte](Get-Random -Max 256) }))
JWT_SECRET=

# Clave para cifrado AES-256-CBC de notificaciones en cola.
# REQUISITO: exactamente 32 bytes (64 caracteres hex).
# Generar con:
#   openssl rand -hex 32
NOTIFICATION_ENCRYPT_KEY=

# Clave general de la aplicación (fallback de JWT y Encryption).
# REQUISITO: mínimo 32 bytes.
# Generar con:
#   openssl rand -hex 32
APP_KEY=

# ─────────────────────────────────────────────────────────────
# CORREO ELECTRÓNICO (Notificaciones y 2FA OTP)
# ─────────────────────────────────────────────────────────────
MAIL_FROM_ADDRESS=no-reply@condominiodigital.com
MAIL_FROM_NAME="Condominio Digital"

# Modo de envío:
#   mock = desarrollo; NO usa la red; escribe app/logs/mail_mock.log y retorna true.
#   smtp = envío real por SMTP autenticado (requiere las claves MAIL_* de abajo).
#   mail = usa la función mail() de PHP (requiere un servidor de correo local).
MAIL_MODE=mock

# ── SMTP (solo si MAIL_MODE=smtp) ────────────────────────────
# MAIL_HOST=smtp.gmail.com     # servidor SMTP
# MAIL_PORT=587                # 587 con STARTTLS; 465 con SSL implícito
# MAIL_ENCRYPTION=tls          # tls | ssl | none
# MAIL_USER=micuenta@gmail.com # usuario SMTP (con Gmail, la dirección completa)
# MAIL_PASS=                   # contraseña SMTP (con Gmail, contraseña de aplicación)
# MAIL_VERIFY_PEER=1           # 1 verifica el certificado del servidor; 0 solo para pruebas locales
# MAIL_CAFILE=                 # opcional: ruta a un bundle CA propio (formato pem)
# MAIL_TIMEOUT=20              # segundos de espera por respuesta del servidor
#
# Ejemplo Gmail (comentado):
# Gmail exige verificación en 2 pasos y una contraseña de aplicación de 16
# caracteres generada en https://myaccount.google.com/apppasswords; la
# contraseña normal de la cuenta NO funciona por SMTP.
#
# MAIL_MODE=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_ENCRYPTION=tls
# MAIL_USER=micuenta@gmail.com
# MAIL_PASS=xxxxxxxxxxxxxxxx
# MAIL_VERIFY_PEER=1
# MAIL_CAFILE=
#
# Nota: con Gmail, use la misma dirección Gmail en MAIL_FROM_ADDRESS (o configure
# "Enviar como" / "Send mail as" en Gmail) para evitar rechazos por remitente.
