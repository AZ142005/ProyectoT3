# ====================================
# ProyectoT3 — Variables de Entorno
# ====================================
# Copiar este archivo a .env y completar los valores

# Base de Datos
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=condominio_cobranzas

# Entorno: 'development' o 'production'
ENVIRONMENT=development

# Clave secreta para JWT (mínimo 64 bytes). Generar con: openssl rand -hex 32
JWT_SECRET=

# Clave para cifrado de notificaciones (mínimo 32 bytes). Generar con: openssl rand -hex 32
NOTIFICATION_ENCRYPT_KEY=

# Clave general de la aplicación (usada como fallback por JWT y Encryption). Generar con: openssl rand -hex 32
APP_KEY=
