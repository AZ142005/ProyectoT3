# ====================================
# ProyectoT3 — Variables de Entorno
# ====================================
# Copiar este archivo a .env y completar los valores ANTES de iniciar la aplicación.

# Base de Datos
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=condominio_cobranzas

# Entorno: 'development' o 'production'
ENVIRONMENT=development

# ─────────────────────────────────────────────────────────────
# CLAVES DE SEGURIDAD (OBLIGATORIAS — Generación Única)
# ─────────────────────────────────────────────────────────────

# Clave secreta para firmar tokens JWT (HS256).
# REQUISITO: mínimo 64 bytes (128 caracteres hex).
# ⚠ NUNCA compartir ni subir al control de versiones.
# Generar con (Linux/macOS/WSL/Git Bash):
#   openssl rand -base64 32
# Generar con PowerShell:
#   [Convert]::ToBase64String((1..32 | ForEach-Object { [byte](Get-Random -Max 256) }))
JWT_SECRET=

# Clave para cifrado AES-256-CBC de notificaciones en cola.
# REQUISITO: exactamente 32 bytes (64 caracteres hex).
# Generar con:
#   openssl rand -hex 32
NOTIFICATION_ENCRYPT_KEY=

# Clave general de la aplicación (fallback de JWT y Encryption).
# REQUISITO: mínimo 32 bytes.
# Generar con:
#   openssl rand -hex 32
APP_KEY=

# ─────────────────────────────────────────────────────────────
# CORREO ELECTRÓNICO (Notificaciones y 2FA OTP)
# ─────────────────────────────────────────────────────────────
MAIL_FROM_ADDRESS=no-reply@condominiodigital.com
MAIL_FROM_NAME="Condominio Digital"
# Modo: 'smtp' (producción) o 'mock' (desarrollo — guarda en app/logs/mail_mock.log)
MAIL_MODE=mock
